# Copy to backend/.env (never commit .env)

# Database. Default: SQLite file backend/data.db
# DATABASE_URL=sqlite:///./data.db

# Deployed frontend origin(s) allowed by CORS, comma-separated.
# http://localhost:5173 is always allowed.
# FRONTEND_URL=https://ai4brain-rami.vercel.app

# Delete events older than this many days (task 2.7)
RETENTION_DAYS=90

# Coach (Member 3, backend/app/coach/)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5
