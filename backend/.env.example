# Copy to backend/.env (never commit .env)

# Database. Default: SQLite file backend/data.db
# DATABASE_URL=sqlite:///./data.db

# Deployed frontend origin(s) allowed by CORS, comma-separated.
# http://localhost:5173 is always allowed.
# FRONTEND_URL=https://ai4brain-rami.vercel.app

# Retention (app/retention.py): raw events older than RETENTION_DAYS are deleted,
# and players inactive for INACTIVE_DAYS are deleted with all their data.
RETENTION_DAYS=90
INACTIVE_DAYS=180

# Load the simulated demo players at startup (set to true on the deployed demo)
# SEED_DEMO=true

# Coach language model (backend/app/coach/llm.py)
# Default: a local model through Ollama (https://ollama.com), no key needed:
#   ollama pull qwen2.5:3b
# COACH_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# COACH_TIMEOUT_S=60
# Or Claude, if you have a key (then the provider switches to it automatically):
# ANTHROPIC_API_KEY=
# COACH_MODEL=claude-sonnet-5-5
